# Backupscripting configuration — copy to backup.env and fill in real values.
#   cp config/backup.env.example config/backup.env && chmod 600 config/backup.env
# backup.env is loaded by lib/common.sh and must NEVER be committed to git.

# ── Object storage target ─────────────────────────────────────────────────
# Production uses the DigitalOcean Space from infra/spaces.tf (tutora-production-backups,
# region sgp1). Use a Spaces access key limited to this one bucket (read/write).
# DUMMY VALUES — replace with real keys.
AWS_ACCESS_KEY_ID=DO00EXAMPLEEXAMPLEEX
AWS_SECRET_ACCESS_KEY=exampleExampleExampleExampleExampleExample0
# Spaces ignores the region for signing; us-east-1 is what DO documents for S3 clients.
AWS_DEFAULT_REGION=us-east-1
# Leave empty for real AWS S3.
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_BUCKET=tutora-production-backups
S3_PREFIX=vertical-platform/postgres
# Archives are named <BACKUP_NAME>_<YYYY-MM-DD>_<HHMMSS>.tar
BACKUP_NAME=vertical

# ── PostgreSQL (dumped from inside the running container) ────────────────
# No password needed here: the script uses the container's own POSTGRES_PASSWORD.
PG_CONTAINER=vertical_postgres_prod
PG_USER=vertical
# Every database in the cluster is backed up automatically (including each
# tenant_<id> DB created at signup). These must exist, or the run fails — it
# protects against pointing at the wrong container.
REQUIRED_DATABASES="vertical_platform_db vertical_db"
# Space-separated databases to skip (optional).
EXCLUDE_DATABASES=""

# ── Retention ─────────────────────────────────────────────────────────────
# Keep the newest N days of backups. With 3: on day 4, day 1's backup is
# deleted — but only after day 4's backup has uploaded and been verified.
RETENTION_DAYS=3

# ── Local paths ───────────────────────────────────────────────────────────
# Staging for dumps; needs free space >= the total database size. Emptied after every run.
BACKUP_TMP_DIR=/opt/vertical/backup_tmp
LOG_DIR=/opt/vertical/Backupscripting/logs
LOG_RETENTION_DAYS=30

# ── Alerting (optional; leave blank to disable) ───────────────────────────
# Slack/Mattermost/Google Chat-style incoming webhook, posted to on failure.
ALERT_WEBHOOK_URL=
# Needs a working `mail` command (mailutils + an MTA) on the server.
ALERT_EMAIL=
# Dead-man's switch pinged after every SUCCESSFUL run (e.g. https://hc-ping.com/<uuid>).
# Set the monitor to expect a ping every 24h — it alerts you when backups stop,
# even if the server is down or cron never fires.
HEARTBEAT_URL=
